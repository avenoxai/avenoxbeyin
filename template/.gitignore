# Secrets, never commit. assert_no_secret_staged in scripts/upgrade.sh refuses to commit
# these paths, so anything it guards must also be ignored here, otherwise the very first
# snapshot stages a secret and the upgrade dies before it starts.
.claude/settings.local.json
.env
*.yedek
*.yedek-*
*.bak
*.orig

# Local runtime state
.claude/hooks/.state/
.claude/scripts/.state/*
!.claude/scripts/.state/.gitkeep
**/.beyin-compact.lock

# Yakala: raw transcripts/page text and captured files stay local
📥 000-Inbox/Yakala/.ham/
📥 000-Inbox/Yakala/dosyalar/

# OS / editor noise
.DS_Store
.beyin-note-write/
.obsidian/workspace*
.obsidian/cache
__pycache__/
*.pyc

# Machine-local hooks and installers (generated per machine by beyin.py init)
.beyin-runtime.json
Beyni Guncelle.cmd
.agents/hooks.json
.codex/hooks.json
.codex/config.toml
.kiro/hooks/beyin-v3.json
.claude/hermes-plugin/__init__.py
.opencode/plugins/beyin-v3.js
.omp/hooks/pre/beyin-v3.ts
.claude/scripts/compile.py
.claude/scripts/flush.py
.claude/hooks/session-start.sh
.claude/hooks/session-start.ps1
.claude/hooks/session-end.sh
.claude/hooks/session-end.ps1
.claude/hooks/pre-compact.sh
.claude/hooks/pre-compact.ps1
.claude/hooks/prompt-counter.sh
.claude/hooks/prompt-counter.ps1
/.pi/extensions/beyin-v3.ts
